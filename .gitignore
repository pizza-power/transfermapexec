# -----------------------------------------------------------------------------
*~
.directory
.Trash-*
.fuse_hidden*
.nfs*

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
# JetBrains (GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace
.history/

# Vim / Neovim
.*.sw?
[._]*.un~
Session.vim
.netrwhist

# Emacs
\#*\#
.\#*
*.elc
.dir-locals.el

# Others
*.sublime-project
*.sublime-workspace
.fleet/
.zed/
.project
.settings/
.classpath

# -----------------------------------------------------------------------------
# AI assistants and coding agents
#
# Nothing an AI tool writes, or reads for instructions, belongs in this repo:
# no agent instruction files, rules, prompts, tool state or MCP config.
# Instruction filenames are spelled out case-insensitively because git matches
# case exactly on Linux even though macOS does not.
# -----------------------------------------------------------------------------
# Instruction and memory files
[Aa][Gg][Ee][Nn][Tt][Ss].md
[Aa][Gg][Ee][Nn][Tt][Ss].*.md
[Aa][Gg][Ee][Nn][Tt].md
[Cc][Ll][Aa][Uu][Dd][Ee].md
[Cc][Ll][Aa][Uu][Dd][Ee].*.md
[Gg][Ee][Mm][Ii][Nn][Ii].md
[Cc][Oo][Pp][Ii][Ll][Oo][Tt]-instructions.md
.github/instructions/
.github/prompts/
.github/chatmodes/
.github/agents/

# Rules and ignore files
.cursorrules
.cursorignore
.cursorindexingignore
.windsurfrules
.clinerules
.roorules
.roomodes
.rooignore
.goosehints
.aiexclude
.aiignore
.claudeignore
.geminiignore
.codeiumignore

# Tool state and config directories
.claude/
.claude.json
.codex/
.gemini/
.cursor/
.windsurf/
.codeium/
.continue/
.cline/
.roo/
.kilocode/
.kiro/
.junie/
.amazonq/
.augment/
.trae/
.opencode/
.copilot/
.tabnine/
.cody/
.goose/
.qodo/
.plandex/
.taskmaster/
.serena/
.specstory/
.agents/
.agent/
.aider*

# MCP server configuration (frequently holds API keys)
.mcp.json
mcp.json
.mcp/
opencode.json
opencode.jsonc

# -----------------------------------------------------------------------------
# Never ignore source (keep this section LAST - the last matching rule wins)
#
# Name-based rules above such as `*credentials*`, `secrets.*` or `*.token`
# would otherwise silently drop legitimately named Go files, e.g.
# credentials_test.go or secrets.go.
# -----------------------------------------------------------------------------
!*.go
!go.mod
!go.sum
